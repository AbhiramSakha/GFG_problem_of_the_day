class Solution:
    def numOfWays(self, n: int, m: int) -> int:
        total_squares = n * m
        total_ways = total_squares * (total_squares - 1)

        attacking_pairs = 0

        if n > 1 and m > 2:
            attacking_pairs += (n - 1) * (m - 2)

        if n > 2 and m > 1:
            attacking_pairs += (n - 2) * (m - 1)

        return total_ways - 4 * attacking_pairs
