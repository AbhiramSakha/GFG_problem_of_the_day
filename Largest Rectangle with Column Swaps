class Solution {
public:
    int maxArea(vector<vector<int>>& mat) {
        int n = mat.size();
        int m = mat[0].size();

        vector<int> height(m, 0);
        int ans = 0;

        for (int i = 0; i < n; i++) {

            // Calculate consecutive 1s for each column
            for (int j = 0; j < m; j++) {
                if (mat[i][j] == 1)
                    height[j]++;
                else
                    height[j] = 0;
            }

            // Sort a COPY, not height itself
            vector<int> sortedHeight = height;
            sort(sortedHeight.begin(), sortedHeight.end(),
                 greater<int>());

            // Since columns can be swapped,
            // use the largest heights together.
            for (int j = 0; j < m; j++) {
                ans = max(ans, sortedHeight[j] * (j + 1));
            }
        }

        return ans;
    }
};
