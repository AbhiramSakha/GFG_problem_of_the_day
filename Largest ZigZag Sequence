class Solution:
    def zigzagSequence(self, mat):
        n = len(mat)

        dp = mat[0][:]

        for i in range(1, n):
            new_dp = [0] * n

            max1 = float('-inf')
            max2 = float('-inf')
            max1_col = -1

            for j in range(n):
                if dp[j] > max1:
                    max2 = max1
                    max1 = dp[j]
                    max1_col = j
                elif dp[j] > max2:
                    max2 = dp[j]

            for j in range(n):
                if j == max1_col:
                    new_dp[j] = mat[i][j] + max2
                else:
                    new_dp[j] = mat[i][j] + max1

            dp = new_dp

        return max(dp)
