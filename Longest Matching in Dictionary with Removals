class Solution:
    def findLongestWord(self, s: str, d: list) -> str:
        n = len(s)
        next_pos = [[n] * 26 for _ in range(n + 1)]

        for i in range(n - 1, -1, -1):
            next_pos[i] = next_pos[i + 1].copy()
            next_pos[i][ord(s[i]) - 97] = i

        best = ""

        for word in d:
            if len(word) < len(best):
                continue

            pos = 0
            valid = True

            for ch in word:
                idx = next_pos[pos][ord(ch) - 97]

                if idx == n:
                    valid = False
                    break

                pos = idx + 1

            if valid:
                if len(word) > len(best) or (
                    len(word) == len(best) and word < best
                ):
                    best = word

        return best
