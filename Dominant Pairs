class Solution {
  public:
    int dominantPairs(vector<int> &arr) {
        int n = arr.size();
        int half = n / 2;
        int ans = 0;

        vector<int> second(arr.begin() + half, arr.end());
        sort(second.begin(), second.end());

        for (int i = 0; i < half; i++) {
            long long target = (long long)arr[i] / 5;

            int low = 0, high = half;

            while (low < high) {
                int mid = low + (high - low) / 2;

                if (5LL * second[mid] <= arr[i])
                    low = mid + 1;
                else
                    high = mid;
            }

            ans += low;
        }

        return ans;
    }
};
