class Solution:
    
    def determinant(self, mat, n):
        
        det = 1
        
        for i in range(n):
            
            pivot = i
            
            while pivot < n and mat[pivot][i] == 0:
                pivot += 1
            
            if pivot == n:
                return 0
            
            if pivot != i:
                mat[i], mat[pivot] = mat[pivot], mat[i]
                det *= -1
            
            det *= mat[i][i]
            
            for j in range(i + 1, n):
                factor = mat[j][i] / mat[i][i]
                
                for k in range(i, n):
                    mat[j][k] -= factor * mat[i][k]
        
        return round(det)

    def countSpanTree(self, n, edges):
        
        if n == 1:
            return 1
        
        degree = [0] * n
        laplacian = [[0] * n for _ in range(n)]
        
        for u, v in edges:
            degree[u] += 1
            degree[v] += 1
            
            laplacian[u][v] -= 1
            laplacian[v][u] -= 1
        
        for i in range(n):
            laplacian[i][i] = degree[i]
        
        # Create cofactor matrix
        cofactor = []
        
        for i in range(1, n):
            row = []
            for j in range(1, n):
                row.append(laplacian[i][j])
            cofactor.append(row)
        
        return self.determinant(cofactor, n - 1)
