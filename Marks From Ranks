class Solution {
public:
    vector<int> getMarks(vector<int> &l, vector<int> &r, vector<int> &rank) {
        int n = l.size();

        vector<long long> prefix(n);

        for (int i = 0; i < n; i++) {
            long long count = (long long)r[i] - l[i] + 1;
            prefix[i] = count + (i > 0 ? prefix[i - 1] : 0);
        }

        vector<int> ans;

        for (int k : rank) {
            int low = 0, high = n - 1;

            while (low < high) {
                int mid = low + (high - low) / 2;

                if (prefix[mid] >= k)
                    high = mid;
                else
                    low = mid + 1;
            }

            long long before = (low == 0) ? 0 : prefix[low - 1];

            int mark = l[low] + (int)(k - before - 1);

            ans.push_back(mark);
        }

        return ans;
    }
};
