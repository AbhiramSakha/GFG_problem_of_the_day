class Solution {
  public:
    int maxFruits(vector<int>& arr, int m) {
        int n = arr.size();
        
        // Duplicate the array so circular subarrays become normal subarrays.
        vector<int> a(2 * n);
        for (int i = 0; i < 2 * n; i++) {
            a[i] = arr[i % n];
        }
        
        long long sum = 0;
        long long ans = 0;
        
        for (int i = 0; i < 2 * n; i++) {
            sum += a[i];
            
            if (i >= m)
                sum -= a[i - m];
            
            if (i >= m - 1)
                ans = max(ans, sum);
        }
        
        return (int)ans;
    }
};
