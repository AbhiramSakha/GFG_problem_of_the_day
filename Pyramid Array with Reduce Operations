class Solution:
    def formPyramid(self, arr):
        n = len(arr)

        left = [0] * n
        right = [0] * n

        left[0] = min(arr[0], 1)
        for i in range(1, n):
            left[i] = min(arr[i], left[i - 1] + 1)

        right[n - 1] = min(arr[n - 1], 1)
        for i in range(n - 2, -1, -1):
            right[i] = min(arr[i], right[i + 1] + 1)

        total = sum(arr)
        max_pyramid_sum = 0

        for i in range(n):
            height = min(left[i], right[i])
            max_pyramid_sum = max(
                max_pyramid_sum,
                height * height
            )

        return total - max_pyramid_sum
