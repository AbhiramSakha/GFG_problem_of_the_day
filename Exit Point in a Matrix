class Solution:
    def exitPoint(self, mat):
        n = len(mat)
        m = len(mat[0])

        i, j = 0, 0
        d = 0 
        while 0 <= i < n and 0 <= j < m:
            if mat[i][j] == 1:
                d = (d + 1) % 4
                mat[i][j] = 0

            if d == 0:
                j += 1
            elif d == 1:
                i += 1
            elif d == 2:
                j -= 1
            else:
                i -= 1

        if j == m:
            j -= 1
        elif i == n:
            i -= 1
        elif j < 0:
            j += 1
        elif i < 0:
            i += 1

        return [i, j]
