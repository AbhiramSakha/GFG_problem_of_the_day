class Solution {
  public:
    int countTriplets(vector<int> &arr, int l, int r) {
        sort(arr.begin(), arr.end());

        int n = arr.size();
        long long ans = 0;

        // Count triplets with sum <= r
        long long high = 0;

        for (int i = 0; i < n - 2; i++) {
            int left = i + 1;
            int right = n - 1;

            while (left < right) {
                long long sum = (long long)arr[i] + arr[left] + arr[right];

                if (sum <= r) {
                    high += right - left;
                    left++;
                } else {
                    right--;
                }
            }
        }

        // Count triplets with sum < l
        long long low = 0;

        for (int i = 0; i < n - 2; i++) {
            int left = i + 1;
            int right = n - 1;

            while (left < right) {
                long long sum = (long long)arr[i] + arr[left] + arr[right];

                if (sum < l) {
                    low += right - left;
                    left++;
                } else {
                    right--;
                }
            }
        }

        return high - low;
    }
};
