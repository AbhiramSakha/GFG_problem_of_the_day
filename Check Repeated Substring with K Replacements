class Solution:
    def kSubstr(self, s: str, k: int) -> bool:
        n = len(s)

        if n % k != 0:
            return False

        parts = [s[i:i + k] for i in range(0, n, k)]

        freq = {}
        for p in parts:
            freq[p] = freq.get(p, 0) + 1

        mx = max(freq.values())

        return len(parts) - mx <= 1
