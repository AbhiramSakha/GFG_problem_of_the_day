class Solution:
    def countStrings(self, n, k):
        MOD = 10**9 + 7
        
        dp0 = [0] * (k + 2)
        dp1 = [0] * (k + 2)
        
        dp0[0] = 1
        dp1[0] = 1
        
        for _ in range(2, n + 1):
            new0 = [0] * (k + 2)
            new1 = [0] * (k + 2)
            
            for j in range(k + 1):
                # Append 0
                new0[j] = (dp0[j] + dp1[j]) % MOD
                
                # Append 1
                new1[j] = (new1[j] + dp0[j]) % MOD
                if j + 1 <= k:
                    new1[j + 1] = (new1[j + 1] + dp1[j]) % MOD
            
            dp0, dp1 = new0, new1
        
        return (dp0[k] + dp1[k]) % MOD
