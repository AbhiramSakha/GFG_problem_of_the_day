class Solution:
    def increasingNumbers(self, n):
        if n == 1:
            return [i for i in range(10)]

        if n > 10:
            return []

        res = []

        def dfs(num, last_digit, length):
            if length == n:
                res.append(int(num))
                return

            for d in range(last_digit + 1, 10):
                dfs(num + str(d), d, length + 1)

        for start in range(1, 10):
            dfs(str(start), start, 1)

        return res
