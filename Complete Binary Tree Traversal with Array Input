class Solution:
    def levelSort(self, arr):
        ans = []
        n = len(arr)
        idx = 0
        level_size = 1

        while idx < n:
            level = arr[idx:min(idx + level_size, n)]
            level.sort()
            ans.append(level)
            idx += level_size
            level_size *= 2

        return ans
