class Solution:
    def sumXOR(self, arr):
        n = len(arr)
        result = 0
        
        for bit in range(32):
            count1 = 0
            for num in arr:
                if num & (1 << bit):
                    count1 += 1
            
            count0 = n - count1
            result += (count1 * count0) * (1 << bit)
        
        return result
