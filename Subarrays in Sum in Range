class Solution:
    def countSubarray(self, arr: list[int], l: int, r: int) -> int:
        def count_at_most(k):
            if k < 0:
                return 0
            left = 0
            curr = 0
            ans = 0
            for right in range(len(arr)):
                curr += arr[right]
                while curr > k:
                    curr -= arr[left]
                    left += 1
                ans += right - left + 1
            return ans

        return count_at_most(r) - count_at_most(l - 1)
