class Solution:
    def maxIndexDifference(self, s):
        n = len(s)
        max_reach = [-1] * 26
        ans = -1

        for i in range(n - 1, -1, -1):
            c = ord(s[i]) - ord('a')

            if c == 25:
                reach = i
            else:
                if max_reach[c + 1] != -1:
                    reach = max_reach[c + 1]
                else:
                    reach = i

            if reach > max_reach[c]:
                max_reach[c] = reach

            if c == 0:
                ans = max(ans, reach - i)

        return ans
