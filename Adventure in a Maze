class Solution:
    def findWays(self, grid):
        n = len(grid)
        MOD = 10**9 + 7

        # dp_paths[i][j] = number of ways to reach (i, j)
        # dp_max[i][j] = maximum adventure to reach (i, j)
        dp_paths = [[0] * n for _ in range(n)]
        dp_max = [[-1] * n for _ in range(n)]

        dp_paths[0][0] = 1
        dp_max[0][0] = grid[0][0]

        for i in range(n):
            for j in range(n):
                if i == 0 and j == 0:
                    continue

                paths = 0
                best = -1

                # From the left: left cell must allow Right movement
                if j > 0 and grid[i][j - 1] in (1, 3):
                    paths += dp_paths[i][j - 1]
                    if dp_max[i][j - 1] != -1:
                        best = max(best, dp_max[i][j - 1])

                # From above: upper cell must allow Down movement
                if i > 0 and grid[i - 1][j] in (2, 3):
                    paths += dp_paths[i - 1][j]
                    paths %= MOD

                    if dp_max[i - 1][j] != -1:
                        best = max(best, dp_max[i - 1][j])

                dp_paths[i][j] = paths % MOD

                if best != -1:
                    dp_max[i][j] = best + grid[i][j]

        if dp_paths[n - 1][n - 1] == 0:
            return [0, 0]

        return [dp_paths[n - 1][n - 1], dp_max[n - 1][n - 1]]
