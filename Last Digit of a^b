class Solution:
    def getLastDigit(self, a, b):
        if b == "0":
            return 1

        last = int(a[-1])

        cycles = {
            0: [0],
            1: [1],
            2: [2, 4, 8, 6],
            3: [3, 9, 7, 1],
            4: [4, 6],
            5: [5],
            6: [6],
            7: [7, 9, 3, 1],
            8: [8, 4, 2, 6],
            9: [9, 1]
        }

        cycle = cycles[last]
        m = len(cycle)

        exp = 0
        for ch in b:
            exp = (exp * 10 + int(ch)) % m

        if exp == 0:
            exp = m

        return cycle[exp - 1]
