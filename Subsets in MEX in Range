class Solution:
    def cntSubsets(self, arr, l, r):
        MOD = 10**9 + 7
        n = len(arr)

        freq = [0] * (n + 1)

        for x in arr:
            freq[x] += 1

        pow2 = [1] * (n + 1)
        for i in range(1, n + 1):
            pow2[i] = (pow2[i - 1] * 2) % MOD

        def count(k):
            if k < 0:
                return 0

            product = 1
            required = 0

            for x in range(k + 1):
                if freq[x] == 0:
                    return pow2[n]

                product = (product * (pow2[freq[x]] - 1)) % MOD
                required += freq[x]

            greater = (product * pow2[n - required]) % MOD

            return (pow2[n] - greater) % MOD

        return (count(r) - count(l - 1)) % MOD
