class Solution {
public:
    string compress(string &s) {
        int n = s.size();

        // Z-function
        vector<int> z(n, 0);

        for (int i = 1, l = 0, r = 0; i < n; i++) {
            if (i <= r)
                z[i] = min(r - i + 1, z[i - l]);

            while (i + z[i] < n && s[z[i]] == s[i + z[i]])
                z[i]++;

            if (i + z[i] - 1 > r) {
                l = i;
                r = i + z[i] - 1;
            }
        }

        // dp[i] = minimum encoded length for s[i...n-1]
        vector<int> dp(n + 1, 0);

        for (int i = n - 1; i >= 0; i--) {
            // Take the current character
            dp[i] = 1 + dp[i + 1];

            // Use '*' if the already-built prefix can be duplicated
            if (i > 0 && 2 * i <= n && z[i] >= i) {
                dp[i] = min(dp[i], 1 + dp[2 * i]);
            }
        }

        // Reconstruct the lexicographically smallest answer
        // among all minimum-length answers.
        string ans;
        int i = 0;

        while (i < n) {
            int normal = 1 + dp[i + 1];

            // Prefer '*' when both choices have the same optimal length.
            if (i > 0 && 2 * i <= n &&
                z[i] >= i &&
                1 + dp[2 * i] <= normal) {

                ans.push_back('*');
                i *= 2;
            } else {
                ans.push_back(s[i]);
                i++;
            }
        }

        return ans;
    }
};
