from collections import deque

class Solution:
    def cntOnes(self, grid):
        n = len(grid)
        m = len(grid[0])

        visited = [[False] * m for _ in range(n)]
        q = deque()

        for i in range(n):
            for j in [0, m - 1]:
                if grid[i][j] == 1 and not visited[i][j]:
                    visited[i][j] = True
                    q.append((i, j))

        for j in range(m):
            for i in [0, n - 1]:
                if grid[i][j] == 1 and not visited[i][j]:
                    visited[i][j] = True
                    q.append((i, j))

        directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]

        while q:
            x, y = q.popleft()

            for dx, dy in directions:
                nx, ny = x + dx, y + dy

                if 0 <= nx < n and 0 <= ny < m:
                    if grid[nx][ny] == 1 and not visited[nx][ny]:
                        visited[nx][ny] = True
                        q.append((nx, ny))

        count = 0

        for i in range(n):
            for j in range(m):
                if grid[i][j] == 1 and not visited[i][j]:
                    count += 1

        return count
