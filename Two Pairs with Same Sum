
class Solution:
    def findPairs(self, arr: list[int]) -> list[int]:
        n = len(arr)
        mp = {}

        for i in range(n):
            for j in range(i + 1, n):
                s = arr[i] + arr[j]

                if s not in mp:
                    mp[s] = []

                mp[s].append((i, j))

        for i in range(n):
            for j in range(i + 1, n):
                s = arr[i] + arr[j]

                for k, l in mp[s]:
                    if (k, l) <= (i, j):
                        continue

                    if i != k and i != l and j != k and j != l:
                        return [i, j, k, l]

        return [-1, -1, -1, -1]
