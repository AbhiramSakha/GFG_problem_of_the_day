class Solution:
    def maxSumSubarray(self, arr):
        n = len(arr)
        
        if n == 1:
            return arr[0]
        
        no_del = arr[0]
        one_del = float('-inf')
        ans = arr[0]
        
        for i in range(1, n):
            one_del = max(one_del + arr[i], no_del)
            no_del = max(no_del + arr[i], arr[i])
            ans = max(ans, no_del, one_del)
        
        return ans
