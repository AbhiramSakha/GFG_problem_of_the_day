class Solution {
  public:
    int maxDiff(Node* root) {
        int ans = INT_MIN;

        function<int(Node*)> dfs = [&](Node* node) {
            if (node == nullptr)
                return INT_MAX;

            int leftMin = dfs(node->left);
            int rightMin = dfs(node->right);

            int childMin = min(leftMin, rightMin);

            if (childMin != INT_MAX)
                ans = max(ans, node->data - childMin);

            return min(node->data, childMin);
        };

        dfs(root);
        return ans;
    }
};
