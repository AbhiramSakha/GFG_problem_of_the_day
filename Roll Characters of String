class Solution:
    def findRollOut(self, s, roll):
        n = len(s)
        cnt = [0] * (n + 2)
        
        for r in roll:
            cnt[r] += 1
        
        res = [''] * n
        total = 0
        
        # go from the last index to the first, accumulating suffix sums
        for i in range(n - 1, -1, -1):
            total += cnt[i + 1]
            shift = total % 26
            res[i] = chr((ord(s[i]) - ord('a') + shift) % 26 + ord('a'))
        
        return ''.join(res)
