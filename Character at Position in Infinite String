
class Solution:
    def posInfinite(self, s: str, pos: int) -> str:
        lengths = [len(s)]

        i = 1
        while lengths[-1] < pos:
            lengths.append(2 * lengths[-1] + i)
            i += 1

        for k in range(len(lengths) - 1, 0, -1):
            prev = lengths[k - 1]

            if pos > prev + k:
                pos = 2 * prev + k - pos + 1
            elif pos > prev:
                return '$'

        return s[pos - 1]
