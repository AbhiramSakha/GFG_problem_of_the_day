class Solution:
    def find(self, arr):
        need = 0

        for i in range(len(arr) - 1, -1, -1):
            need = (need + arr[i] + 1) // 2

        return need

        lo, hi = 0, max(arr)

        while not check(hi):
            hi *= 2

        while lo < hi:
            mid = (lo + hi) // 2
            if check(mid):
                hi = mid
            else:
                lo = mid + 1

        return lo
