class Solution {
  public:
    int minThrows(int n, vector<int>& lad, vector<int>& sn) {
        int N = n * n;

        vector<int> jump(N + 1, 0);

        // Ladders
        for (int i = 0; i < (int)lad.size(); i += 2) {
            jump[lad[i]] = lad[i + 1];
        }

        // Snakes
        for (int i = 0; i < (int)sn.size(); i += 2) {
            jump[sn[i]] = sn[i + 1];
        }

        vector<int> dist(N + 1, -1);
        queue<int> q;

        dist[1] = 0;
        q.push(1);

        while (!q.empty()) {
            int cur = q.front();
            q.pop();

            if (cur == N)
                return dist[cur];

            for (int dice = 1; dice <= 6; dice++) {
                int next = cur + dice;

                if (next > N)
                    break;

                // Take snake/ladder immediately.
                if (jump[next] != 0)
                    next = jump[next];

                if (dist[next] == -1) {
                    dist[next] = dist[cur] + 1;
                    q.push(next);
                }
            }
        }

        return -1;
    }
};
