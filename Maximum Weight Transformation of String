class Solution:
    def getMaxWeight(self, s):
        n = len(s)
        dp = [0] * (n + 1)
        dp[0] = 0

        for i in range(1, n + 1):
            dp[i] = dp[i - 1] + 1
            if i >= 2:
                dp[i] = max(dp[i], dp[i - 2] + 4 - (s[i - 1] == s[i - 2]))

        return dp[n]
