class Solution:
    def lexicographicallySmallest(self, s, k):
        n = len(s)
        if n & (n - 1) == 0:
            k //= 2
        else:
            k *= 2

        if k >= n:
            return -1

        remove = k
        stack = []

        for ch in s:
            while remove > 0 and stack and stack[-1] > ch:
                stack.pop()
                remove -= 1
            stack.append(ch)

        while remove > 0:
            stack.pop()
            remove -= 1

        ans = ''.join(stack)

        return ans if ans else -1
