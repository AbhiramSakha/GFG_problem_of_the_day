class Solution {
  public:
    long long pairAndSum(vector<int> &arr) {
        long long ans = 0;
        int n = arr.size();

        for (int bit = 0; bit < 31; bit++) {
            long long count = 0;

            for (int x : arr) {
                if (x & (1 << bit)) {
                    count++;
                }
            }

            // Every pair having this bit set contributes 2^bit
            ans += count * (count - 1) / 2 * (1LL << bit);
        }

        return ans;
    }
};
