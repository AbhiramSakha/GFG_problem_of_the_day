class Solution:
    def findMax(self, n, a, b, k):
        diff = [0] * (n + 1)

        for l, r, val in zip(a, b, k):
            diff[l] += val
            if r + 1 < n:
                diff[r + 1] -= val

        curr = 0
        ans = 0
        for i in range(n):
            curr += diff[i]
            if curr > ans:
                ans = curr

        return ans
