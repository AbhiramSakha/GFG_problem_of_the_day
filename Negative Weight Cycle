class Solution {
public:
    bool isNegativeWeightCycle(int V, vector<vector<int>>& edges) {
        vector<long long> dist(V, 0);

        // Bellman-Ford: initialize all vertices to 0 so that
        // cycles in any disconnected component are also detected.
        for (int i = 0; i < V; i++) {
            bool updated = false;

            for (auto &e : edges) {
                int u = e[0];
                int v = e[1];
                int w = e[2];

                if (dist[v] > dist[u] + w) {
                    dist[v] = dist[u] + w;
                    updated = true;

                    // Relaxation on the V-th iteration => negative cycle
                    if (i == V - 1)
                        return true;
                }
            }

            if (!updated)
                break;
        }

        return false;
    }
};
