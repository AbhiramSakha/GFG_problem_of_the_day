class Solution:
    def beautySum(self, s: str) -> int:
        n = len(s)
        ans = 0

        for i in range(n):
            freq = [0] * 26
            max_freq = 0

            for j in range(i, n):
                idx = ord(s[j]) - ord('a')
                freq[idx] += 1
                max_freq = max(max_freq, freq[idx])

                min_freq = n
                for k in range(26):
                    if freq[k] > 0:
                        min_freq = min(min_freq, freq[k])

                ans += max_freq - min_freq

        return ans
