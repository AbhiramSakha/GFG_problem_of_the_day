#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<vector<int>> searchWord(vector<vector<char>> &mat, string &word) {
        int n = mat.size();
        int m = mat[0].size();

        // 8 directions
        int dr[] = {-1, -1, -1, 0, 0, 1, 1, 1};
        int dc[] = {-1, 0, 1, -1, 1, -1, 0, 1};

        vector<vector<int>> ans;

        int len = word.size();

        // Try every cell as starting position
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                // First character must match
                if (mat[i][j] != word[0])
                    continue;

                // Try all 8 directions
                for (int d = 0; d < 8; d++) {
                    int r = i;
                    int c = j;
                    int k = 0;

                    while (k < len) {

                        // Outside grid
                        if (r < 0 || r >= n || c < 0 || c >= m)
                            break;

                        // Character doesn't match
                        if (mat[r][c] != word[k])
                            break;

                        r += dr[d];
                        c += dc[d];
                        k++;
                    }

                    // Complete word found
                    if (k == len) {
                        ans.push_back({i, j});
                        break;
                    }
                }
            }
        }

        return ans;
    }
};
